{
  "name": "playlarr",
  "version": "2.2.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "scripts": {
    "prepare": "husky",
    "actionlint": "github-actionlint",
    "dev": "next dev --port 8787",
    "build": "next build",
    "start": "next start --port 8787",
    "worker": "tsx src/server/jobs/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate": "npm run actionlint && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^12.4.6",
    "next": "16.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-playwright": "^2.4.0",
    "eslint-plugin-promise": "^7.2.1",
    "github-actionlint": "1.7.12",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "4.1.11"
  }
}
