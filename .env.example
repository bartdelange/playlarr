# Required by MusicBrainz. Include a real contact address or URL.
MUSICBRAINZ_USER_AGENT=music-importer/0.1 (you@example.com)
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
MUSICBRAINZ_REQUEST_DELAY=1.1
MUSICBRAINZ_REQUEST_TIMEOUT=30
MUSICBRAINZ_MAX_RETRIES=5

# Local defaults. Container deployments set these paths in the image.
TZ=UTC
DATA_DIR=.data
OUTPUT_DIR=output
TIDAL_SESSION_FILE=.secrets/tidal-session.json
SPOTIFY_TOKEN_CACHE=.secrets/spotify-token.json

# Spotify uses PKCE, so no client secret is needed.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/callback

LIDARR_URL=http://192.168.1.10:8686
LIDARR_API_KEY=
LIDARR_ROOT_FOLDER=/music
LIDARR_QUALITY_PROFILE_ID=1
LIDARR_METADATA_PROFILE_ID=1
