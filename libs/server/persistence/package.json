{
  "name": "@playlarr/server-persistence",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "server-persistence",
    "tags": [
      "type:persistence"
    ],
    "targets": {
      "prisma-generate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm prisma generate --config libs/server/persistence/prisma.config.ts"
        }
      },
      "migrate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm prisma migrate deploy --config libs/server/persistence/prisma.config.ts"
        }
      }
    }
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0"
  }
}
