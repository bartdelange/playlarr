      "type:feature",
      "platform:web"
    ]
  },
  "dependencies": {
    "@playlarr/shared-web-infrastructure": "workspace:*",
    "@playlarr/tidal-contracts": "workspace:*",
    "next": "~16.1.7",
    "react": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "^14.6.6"
  }
